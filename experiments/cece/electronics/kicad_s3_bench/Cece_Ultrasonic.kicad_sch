(text "CECE - HC-SR04 ULTRASONIC CONNECTIONS" (at 20.32 15.24 0) (effects (font (size 2 2)) (justify left top)) (uuid "843602cd-454b-4d71-ab0b-c41f60f62923"))
(text "D0 / GPIO1 -> TRIG | D1 / GPIO2 <- divided ECHO | 5V from UBEC | common ground" (at 20.32 22.86 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "bcfc1974-548a-432f-abf1-cd715c65bebd"))
(text "To XIAO D1 / GPIO2" (at 48.26 96.52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "67a901dc-1578-4564-915a-4ca12edc3b70"))
(text "R1: ECHO -> GPIO node\nR2: GPIO node -> GND\n5V echo becomes about 3.0V.\nNever connect raw ECHO directly to ESP." (at 20.32 137.16 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "49c0813d-806d-408a-88a4-672a61c0473b"))
(text "C2 across VCC/GND, close to sensor.\nUse 2.2k and 3.3k through-hole resistors, 1%.\nTRIG is a 3.3V pulse, at least 10us.\nVerify trigger response on your sensor." (at 137.16 137.16 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "90234b38-c522-4220-bc33-c04c688af374"))
(text "Terminal labels show electrical connections, not physical pin order. Follow VCC/TRIG/ECHO/GND on your board.\nFirmware allocation: GPIO1 trigger, GPIO2 echo. Existing S3 media/servo firmware does not yet read this sensor.\nUse battery RUN mode for sensor tests; do not feed the sensor from the raw 2S battery or the ESP 3V3 rail." (at 20.32 165.1 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "3be25308-6131-4c59-9970-1ef5bb3bf07a"))
)
