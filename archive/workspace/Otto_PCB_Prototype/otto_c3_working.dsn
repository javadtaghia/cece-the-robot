      (pins R1-1 J5-3)
    )
    (net PIEZO_SIGNAL
      (pins R7-2 BZ1-1)
    )
    (class kicad_default "" 5V_SERVO BAT_PLUS ECHO_5V ESP_5V GND GPIO0 GPIO1
      GPIO3 GPIO4 GPIO5 GPIO6 GPIO7 PIEZO_SIGNAL SERVO_FL SERVO_FR SERVO_LL
      SERVO_LR
